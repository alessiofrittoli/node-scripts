{
	"name": "@alessiofrittoli/node-scripts",
	"version": "3.4.0",
	"description": "Utility library with common Node.js scripts",
	"type": "module",
	"author": {
		"name": "Alessio Frittoli",
		"email": "info@alessiofrittoli.it",
		"url": "https://alessiofrittoli.it"
	},
	"license": "MIT",
	"funding": [
		{
			"type": "github",
			"url": "https://github.com/sponsors/alessiofrittoli"
		}
	],
	"keywords": [
		"nodejs",
		"node-scripts"
	],
	"homepage": "https://github.com/alessiofrittoli/node-scripts#readme",
	"bugs": {
		"url": "https://github.com/alessiofrittoli/node-scripts/issues",
		"email": "info@alessiofrittoli.it"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/alessiofrittoli/node-scripts.git"
	},
	"engines": {
		"node": ">=24.15.0",
		"pnpm": ">=11.27.1"
	},
	"main": "./dist/index.cjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"files": [
		"dist"
	],
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.mts",
				"default": "./dist/index.mjs"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		},
		"./*": {
			"import": {
				"types": "./dist/*/index.d.mts",
				"default": "./dist/*/index.mjs"
			},
			"require": {
				"types": "./dist/*/index.d.cts",
				"default": "./dist/*/index.cjs"
			}
		}
	},
	"sideEffects": false,
	"scripts": {
		"//1a": "*********************************************************************",
		"//1b": "******************** DEV - BUILD - LINT - RELEASE *******************",
		"//1c": "*********************************************************************",
		"dev": "tsdown --watch",
		"build": "pnpm lint && pnpm tsc && pnpm tsdown",
		"lint": "oxlint --report-unused-disable-directives --max-warnings 0",
		"release": "node scripts/release.ts --verbose --npm",
		"diff": "vite-node scripts/diffPatch.ts --verbose --staged --file",
		"//2a": "*********************************************************************",
		"//2b": "***************************** UNIT TESTS ****************************",
		"//2c": "*********************************************************************",
		"test": "vitest --reporter=tree",
		"test:watch": "pnpm test watch",
		"test:ci": "pnpm test run",
		"//3a": "*********************************************************************",
		"//3b": "************************ UNIT TESTS COVERAGE ************************",
		"//3c": "*********************************************************************",
		"test:coverage": "pnpm test:watch --coverage",
		"test:coverage:ci": "pnpm test:ci --coverage",
		"test:serve-coverage": "http-server ./coverage --gzip true -p 0 -o /index.html --silent",
		"test:coverage:serve": "concurrently --prefix none --kill-others \"pnpm test:coverage\" \"pnpm test:serve-coverage\""
	},
	"devDependencies": {
		"@alessiofrittoli/package-configs": "^1.5.0",
		"@alessiofrittoli/type-utils": "^1.9.0",
		"@types/node": "^24.19.1",
		"@vitest/coverage-v8": "^5.0.3",
		"concurrently": "^9.2.1",
		"http-server": "^14.1.1",
		"oxlint": "^1.86.0",
		"prettier": "^3.9.9",
		"prettier-plugin-sort-imports": "^1.8.11",
		"tsdown": "^0.23.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.2",
		"vite-node": "^6.0.0",
		"vitest": "^5.0.3"
	},
	"dependencies": {
		"@alessiofrittoli/abort-controller": "^0.1.0",
		"@alessiofrittoli/event-emitter": "^1.6.0",
		"@alessiofrittoli/exception": "^3.5.0",
		"@alessiofrittoli/web-utils": "^2.3.0"
	}
}
